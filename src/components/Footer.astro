---
import type { NavSection } from "../lib/taxonomy";
import type { SectionId } from "../data/taxonomy";

interface Props { tree: NavSection[]; sectionCounts: Map<SectionId, number> }
const { tree: _tree, sectionCounts: _sectionCounts } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__meta">
      <span>© {year} BRIEFLO</span>
      <span>만드는 사람을 위한 기술 큐레이션</span>
      <a href="/feed.xml">RSS</a>
      <a href="/about/">소개</a>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); margin-top: var(--space-6); padding: var(--space-5) 0; background: var(--bg-subtle); font-size: 0.9rem; }
  .footer__inner { max-width: 1360px; margin: 0 auto; padding: 0 var(--space-3); }
  .footer__meta { color: var(--fg-muted); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .footer__meta a { color: var(--fg-muted); text-decoration: none; }
  .footer__meta a:hover { color: var(--accent); }
</style>
