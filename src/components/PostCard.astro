---
import TypeBadge from "./TypeBadge.astro";
import LevelBadge from "./LevelBadge.astro";
import { readingMinutes, type Post } from "../lib/posts";
import { getHubById } from "../lib/taxonomy";

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const minutes = readingMinutes(post.body ?? "");
const tags = post.data.tags.slice(0, 3);
const hubLabel = getHubById(post.data.hub)?.label ?? post.data.hub;
---

<article class:list={["card", { "card--featured": featured }]}>
  <header class="card__head">
    <span class="card__head-text">
      <a class="card__hub" href={`/${post.data.section}/${post.data.hub}/`}>{hubLabel}</a>
      <time class="card__date" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("ko-KR")}
      </time>
    </span>
  </header>
  <h3 class="card__title">
    <a href={post.data.permalink}>{post.data.title}</a>
  </h3>
  <p class="card__desc">{post.data.description}</p>
  <p class="card__meta">
    <TypeBadge type={post.data.type} />
    <LevelBadge level={post.data.level} />
    <span>약 {minutes}분</span>
    {tags.map((tag) => <span class="card__tag">#{tag}</span>)}
  </p>
</article>

<style>
  .card {
    padding: var(--space-4);
    border-bottom: 1px solid var(--border);
    border-radius: 18px;
    transition: background-color .2s ease, transform .2s ease;
  }
  .card:hover { background: var(--bg-subtle); transform: translateY(-1px); }
  .card--featured { margin: var(--space-3) 0 var(--space-4); padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--border-muted); border-radius: var(--radius-card); background: linear-gradient(145deg, var(--bg-subtle), var(--surface)); box-shadow: var(--shadow-card); }
  .card--featured .card__title { max-width: 760px; font-size: clamp(1.7rem, 3vw, 2.35rem); line-height: 1.25; letter-spacing: -.045em; }
  .card--featured .card__desc { max-width: 680px; font-size: 1rem; -webkit-line-clamp: 3; }
  .card--featured .card__head::before {
    content: "FEATURED";
    margin-right: 10px;
    color: var(--accent);
    font: inherit;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
  }
  .card__head {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .card__head-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .card__hub {
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .card__hub:hover {
    color: var(--accent);
  }
  .card__date {
    color: var(--fg-muted);
    font-size: 0.78rem;
  }
  .card__title {
    margin: 0 0 var(--space-1);
    font-size: 1.15rem;
    line-height: 1.45;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .card__title a {
    color: var(--fg);
    text-decoration: none;
  }
  .card__title a:hover {
    color: var(--accent);
  }
  .card__desc {
    margin: 0 0 var(--space-2);
    color: var(--fg-muted);
    font-size: 0.93rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-2);
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.82rem;
  }
  .card__tag {
    color: var(--accent);
  }
</style>
