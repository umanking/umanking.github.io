---
// 애드센스 수동 배치 슬롯. Auto ads는 쓰지 않는다 — 레이아웃을 예측 불가능하게
// 흔들어 CLS를 망친다. min-height를 미리 예약해 광고 로드 전후로 레이아웃이
// 밀리지 않게 한다.
//
// push({}) 호출은 여기서 하지 않는다. 슬롯마다 인라인 스크립트를 반복하면
// 인라인 JS 예산을 금방 넘기므로, Base.astro의 스크립트 하나가 페이지의 모든
// ins.adsbygoogle을 한 번에 순회하며 push한다.
interface Props {
  slot: string;
  format?: "auto" | "fluid";
  /** fluid 포맷(in-feed) 슬롯은 layout 지정이 없으면 실제로 채워지지 않을 수 있다.
      원본 Jekyll 스니펫(_includes/google-adsense-feed.html)의 data-ad-layout="in-article" 참조. */
  layout?: string;
  minHeight?: number;
  label?: string;
}
const { slot, format = "auto", layout, minHeight = 280, label = "광고" } = Astro.props;
const client = "ca-pub-2431823363518805";
---

<aside class="ad" style={`min-height:${minHeight}px`} aria-label={label}>
  <span class="ad__label">{label}</span>
  <ins
    class="adsbygoogle"
    style={`display:block;min-height:${minHeight - 20}px`}
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format={format}
    data-ad-layout={layout}
    data-full-width-responsive={format === "auto" ? "true" : undefined}
  ></ins>
</aside>

<style>
  .ad {
    display: block;
    margin: var(--space-5) 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    /* min-height는 인라인으로 예약해 CLS를 억제한다 */
    contain: layout;
  }
  .ad__label { display: block; font-size: 0.72rem; color: var(--fg-muted); margin-bottom: var(--space-2); }
</style>
