---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && (
  <details class="toc" open>
    <summary class="toc__title">이 글에서 살펴볼 내용 · {items.length}</summary>
    <ul>
      {items.map((h) => (
        <li class={`toc__d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ul>
  </details>
)}

<style>
  .toc { font-size: 0.86rem; border: 1px solid var(--border); border-radius: 8px; padding: var(--space-2) var(--space-3); margin: 0 0 var(--space-4); }
  .toc__title { font-weight: 600; cursor: pointer; min-height: 44px; align-content: center; }
  .toc__title:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .toc ul { list-style: none; padding: 0; margin: var(--space-2) 0 0; border-left: 2px solid var(--border); }
  .toc li { padding: 3px 0 3px var(--space-3); }
  .toc__d3 { padding-left: var(--space-4); }
  .toc a { color: var(--fg-muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
</style>
