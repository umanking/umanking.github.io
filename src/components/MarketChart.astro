---
interface Props { symbols: string[] }
const { symbols } = Astro.props;
---
<section class="market-chart" aria-label="ETF 가격 차트" data-symbols={JSON.stringify(symbols)}>
  <h2>가격 흐름 직접 확인하기</h2>
  <p>아래는 가격 확인용 외부 차트입니다. 본문의 배당 재투자 포함 NAV 성과와 다릅니다. 기간·통화·조정 설정과 데이터 시각을 차트에서 확인하세요. 시세가 지연되거나 종목이 지원되지 않을 수 있습니다.</p>
  <button type="button" data-load-chart>TradingView 가격 차트 열기</button>
  <div class="chart-host" hidden></div>
  <p class="chart-status" role="status">버튼을 누르면 외부 서비스에 연결합니다.</p>
  <p>{symbols.map((symbol,i)=><><a href={`https://www.tradingview.com/symbols/${symbol.replace(':','-')}/`} target="_blank" rel="noopener noreferrer">{symbol.split(':')[1]} 차트 원문</a>{i<symbols.length-1?' · ':''}</>)} · Charts by TradingView</p>
</section>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('.market-chart')) {
    section.querySelector('button')?.addEventListener('click', () => {
      const host=section.querySelector<HTMLElement>('.chart-host')!;
      const status=section.querySelector<HTMLElement>('.chart-status')!;
      if(host.dataset.loaded) return;
      host.dataset.loaded='true'; host.hidden=false;
      const wrapper=document.createElement('div'); wrapper.className='tradingview-widget-container'; wrapper.style.height='100%';
      const widget=document.createElement('div');widget.className='tradingview-widget-container__widget';wrapper.append(widget);
      const attribution=document.createElement('div');attribution.className='tradingview-widget-copyright';
      const link=document.createElement('a');link.href='https://www.tradingview.com/';link.target='_blank';link.rel='noopener nofollow';link.textContent='Track markets on TradingView';attribution.append(link);wrapper.append(attribution);
      const script=document.createElement('script');script.src='https://s3.tradingview.com/external-embedding/embed-widget-symbol-overview.js';script.async=true;
      const symbols: string[]=JSON.parse(section.dataset.symbols!);
      script.textContent=JSON.stringify({symbols:symbols.map(s=>[s.split(':')[1],s+'|12M']),chartOnly:false,width:'100%',height:'100%',locale:'kr',colorTheme:document.documentElement.dataset.theme==='dark'?'dark':'light',autosize:true,showVolume:false,showMA:false,hideDateRanges:false,hideMarketStatus:false,hideSymbolLogo:false,scalePosition:'right',scaleMode:'Normal',chartType:'line',dateRanges:['1m|1D','3m|1D','12m|1D','60m|1W','all|1M']});
      script.onerror=()=>{status.textContent='차트를 불러오지 못했습니다. 아래 차트 원문 링크를 이용하세요.';host.hidden=true;};
      status.textContent='차트가 비어 있거나 지원되지 않는 종목이면 아래 원문 링크를 이용하세요.';
      wrapper.append(script);host.append(wrapper);(section.querySelector('button') as HTMLButtonElement).disabled=true;
    });
  }
</script>
<style>
  .market-chart { margin: 40px 0; padding: 22px; border: 1px solid var(--border); border-radius: 12px; }
  .market-chart h2 { margin-top: 0; font-size: 1.2rem; }
  .market-chart p { font-size: .85rem; color: var(--fg-muted); }
  button { min-height: 44px; padding: 10px 16px; background: var(--accent); color: white; border: 0; border-radius: 8px; cursor: pointer; }
  button:disabled { opacity: .6; cursor: default; }
  .chart-host { height: 440px; margin-top: 20px; }
</style>
