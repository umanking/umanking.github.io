---
import Nav from "./Nav.astro";
import type { SectionId } from "../data/taxonomy";

interface Props { sectionCounts: Map<SectionId, number> }
const { sectionCounts } = Astro.props;
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href="/" aria-label="Layer 홈">
      <svg class="topbar__mark" viewBox="0 0 28 28" aria-hidden="true">
        <path d="M5 7.5h18M7.5 14h13M10 20.5h8" />
      </svg>
      <span class="topbar__wordmark">Layer</span>
    </a>

    <Nav sectionCounts={sectionCounts} />

    <form class="topbar__search" action="/search/" method="get">
      <label class="sr-only" for="topbar-search">검색</label>
      <input id="topbar-search" name="q" type="search" placeholder="검색어를 입력하세요" autocomplete="off" />
    </form>

    <button
      id="theme-toggle"
      class="topbar__theme"
      type="button"
      aria-label="라이트/다크 테마 전환"
      aria-pressed="false"
    >
      <span class="icon-sun" aria-hidden="true">☀</span>
      <span class="icon-moon" aria-hidden="true">☾</span>
    </button>
  </div>
</header>

{/* aria-pressed는 "현재 다크 모드인가"를 반영해 스크린리더가 버튼에서
   현재 테마 상태를 알 수 있게 한다. 2KB 인라인 스크립트 예산 때문에
   압축된 형태로 쓴다. */}
<script is:inline>(()=>{var b=document.getElementById("theme-toggle");if(!b)return;var r=document.documentElement,d=()=>{var c=r.getAttribute("data-theme");return c?c=="dark":matchMedia("(prefers-color-scheme: dark)").matches};b.setAttribute("aria-pressed",""+d());b.onclick=()=>{var n=d()?"light":"dark";r.setAttribute("data-theme",n);try{localStorage.setItem("theme",n)}catch(e){}b.setAttribute("aria-pressed",n=="dark")}})();</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }
  .topbar__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-3);
    min-height: 56px;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .topbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 56px;
    font-weight: 650;
    font-size: 1.12rem;
    letter-spacing: -0.035em;
    color: var(--fg);
    text-decoration: none;
  }
  .topbar__mark { width: 27px; height: 27px; color: var(--fg); }
  .topbar__mark path { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .topbar__wordmark { letter-spacing: -.045em; }
  .topbar__search {
    width: min(240px, 20vw);
    margin-left: auto;
    margin-top: 10px;
  }
  .topbar__search input {
    width: 100%;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-translucent);
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .topbar__theme {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    margin-top: 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font-size: 1rem;
    cursor: pointer;
  }
  .topbar__theme:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 760px) {
    .topbar__inner { flex-wrap: wrap; gap: 0 var(--space-3); }
    .topbar__search {
      display: none;
    }
    .topbar__theme { margin-left: auto; }
  }
</style>
