---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Toc from "../components/Toc.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import SeriesNav from "../components/SeriesNav.astro";
import Comments from "../components/Comments.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import PostTags from "../components/PostTags.astro";
import MarketChart from "../components/MarketChart.astro";
import { readingMinutes, type Post } from "../lib/posts";
import { getSection, getHub } from "../lib/taxonomy";
import { blogPostingLd, breadcrumbLd, organizationLd } from "../lib/jsonld";
import { buildTitle, absolute } from "../lib/seo";

interface Props { post: Post; headings: MarkdownHeading[] }
const { post, headings } = Astro.props;

const section = getSection(post.data.section);
const hub = getHub(post.data.section, post.data.hub);
const canonical = new URL(post.data.permalink, Astro.site).href;
const minutes = readingMinutes(post.body ?? "");

const crumbs = [
  { label: "홈", href: "/" },
  ...(section ? [{ label: section.label, href: `/${section.id}/` }] : []),
  ...(section && hub ? [{ label: hub.label, href: `/${section.id}/${hub.id}/` }] : []),
  { label: post.data.title },
];

const titleTag = buildTitle(post.data.title);

const ogImage = absolute(`/og${post.data.permalink}index.png`);
const jsonLd = [
  organizationLd(),
  blogPostingLd({
    title: post.data.title,
    description: post.data.description,
    url: canonical,
    datePublished: post.data.date,
    dateModified: post.data.date,
    image: ogImage,
    section: section?.label ?? "",
    keywords: post.data.tags,
  }),
  breadcrumbLd(crumbs),
];
---

<Base
  title={titleTag}
  description={post.data.description}
  canonical={canonical}
  noindex={post.data.noindex}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.date.toISOString()}
  section={section?.label}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <article class="post prose">
    <Breadcrumb items={crumbs} />
    <h1>{post.data.title}</h1>
    <p class="post__meta">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("ko-KR")}
      </time>
      <span>· 약 {minutes}분</span>
    </p>

    <section class="post__brief" aria-label="글 요약">
      <span>IN BRIEF · 읽기 전에</span>
      <p>{post.data.description}</p>
    </section>
    <Toc headings={headings} />
    <SeriesNav post={post} />
    <slot />
    {post.data.marketSymbols?.length && <MarketChart symbols={post.data.marketSymbols} />}
    <PostTags tags={post.data.tags} />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2431823363518805"
      crossorigin="anonymous"
    ></script>
    <!-- 인피드광고 -->
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-format="fluid"
      data-ad-layout-key="-ef+6k-30-ac+ty"
      data-ad-client="ca-pub-2431823363518805"
      data-ad-slot="8738637897"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    <RelatedPosts post={post} />
    <Comments />
  </article>
</Base>

<style>
  .post { min-width: 0; padding-top: var(--space-4); }
  .post h1 { font-size: clamp(1.8rem, 3vw, 2.65rem); line-height: 1.3; letter-spacing: -.045em; margin: 0 0 20px; }
  .post__brief { margin: 28px 0; padding: 24px; background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 10px 10px 0; }
  .post__brief span { font-size: .7rem; font-weight: 700; letter-spacing: .08em; color: var(--accent); }
  .post__brief p { margin: 10px 0 0; font-size: 1rem; }
  .post__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); color: var(--fg-muted); font-size: 0.85rem; margin: 0 0 var(--space-4); }
</style>
