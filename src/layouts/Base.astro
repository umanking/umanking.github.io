---
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RightRail, { type RailHub } from "../components/RightRail.astro";
import { getNavTree, getSectionCounts, topHubsFromTree } from "../lib/taxonomy";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  /**
   * 우측 레일 위젯. 페이지가 넘기지 않으면 사이트 전체 인기 주제로 대체한다.
   * 슬롯이 아니라 prop인 이유: Astro named slot은 부모가 슬롯을 "전달"만
   * 해도(내용이 실제로 비어 있어도) 채워진 것으로 간주해 폴백을 무력화한다.
   * prop 기본값은 순수 JS 로직이라 그 문제가 없다.
   */
  rightRail?: { title: string; hubs: RailHub[] };
}
const { title, description, canonical, noindex = false, rightRail } = Astro.props;

// Nav/Footer/우측 레일 기본값이 각자 getNavTree()·getSectionCounts()를 따로
// 호출하던 것을 여기서 한 번만 계산해 내려보낸다.
const tree = await getNavTree();
const sectionCounts = await getSectionCounts();
const resolvedRightRail = rightRail ?? {
  title: "인기 주제",
  hubs: topHubsFromTree(tree, 5).map((h) => ({
    href: `/${h.sectionId}/${h.id}/`,
    label: h.label,
    count: h.count,
  })),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="naver-site-verification" content="46d4c4d3f1013de17dee96a763e94028323e4b00" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {
          /* 스토리지 접근 불가 환경은 시스템 색상 스킴을 그대로 따른다 */
        }
      })();
    </script>
    <script is:inline>
      document.addEventListener("click", function (e) {
        var btn = e.target.closest && e.target.closest("[data-copy]");
        if (!btn) return;
        var pre = btn.closest(".codeblock").querySelector("pre");
        if (!pre || !navigator.clipboard) return;
        navigator.clipboard.writeText(pre.innerText).then(function () {
          btn.setAttribute("data-copied", "");
          btn.textContent = "복사됨";
          setTimeout(function () {
            btn.removeAttribute("data-copied");
            btn.textContent = "복사";
          }, 1500);
        });
      });
    </script>
    {/*
      preload 대상은 146편 본문의 문자 빈도를 실측해서 고른 것이다.
      subset.90(48.3%) + 91(20.5%) + 89(14.8%) = 본문 한글의 약 84%.
      Pretendard의 dynamic subset은 코드포인트 내림차순이라 흔히 쓰는 음절이
      뒤쪽 번호에 몰려 있다. subset.0은 CJK 호환 한자로 사용률이 0%였다.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.90.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.91.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.89.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <TopBar />
    <div class="shell">
      <Nav tree={tree} sectionCounts={sectionCounts} />
      <main id="main" class="shell__main">
        <slot />
      </main>
      <aside class="shell__right" aria-label="관련 정보">
        <RightRail title={resolvedRightRail.title} hubs={resolvedRightRail.hubs} />
      </aside>
    </div>
    <Footer tree={tree} sectionCounts={sectionCounts} />
  </body>
</html>
