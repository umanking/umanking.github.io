---
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RightRail from "../components/RightRail.astro";
import { getTopHubs } from "../lib/taxonomy";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex = false } = Astro.props;

// 우측 레일 기본값: 어떤 페이지가 named slot을 채우지 않으면 사이트 전체 인기 주제를 보여준다.
const defaultTopHubs = (await getTopHubs(5)).map((h) => ({
  href: `/${h.sectionId}/${h.id}/`,
  label: h.label,
  count: h.count,
}));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="naver-site-verification" content="46d4c4d3f1013de17dee96a763e94028323e4b00" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {
          /* 스토리지 접근 불가 환경은 시스템 색상 스킴을 그대로 따른다 */
        }
      })();
    </script>
    {/*
      preload 대상은 146편 본문의 문자 빈도를 실측해서 고른 것이다.
      subset.90(48.3%) + 91(20.5%) + 89(14.8%) = 본문 한글의 약 84%.
      Pretendard의 dynamic subset은 코드포인트 내림차순이라 흔히 쓰는 음절이
      뒤쪽 번호에 몰려 있다. subset.0은 CJK 호환 한자로 사용률이 0%였다.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.90.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.91.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.89.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <TopBar />
    <div class="shell">
      <Nav />
      <main id="main" class="shell__main">
        <slot />
      </main>
      <aside class="shell__right" aria-label="관련 정보">
        <slot name="right-rail">
          <RightRail title="인기 주제" hubs={defaultTopHubs} />
        </slot>
      </aside>
    </div>
    <Footer />
  </body>
</html>
