---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RightRail, { type RailHub } from "../components/RightRail.astro";
import { getNavTree, getSectionCounts, topHubsFromTree } from "../lib/taxonomy";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  jsonLd?: object[];
  /**
   * 우측 레일 위젯. 페이지가 넘기지 않으면 사이트 전체 인기 주제로 대체한다.
   * 슬롯이 아니라 prop인 이유: Astro named slot은 부모가 슬롯을 "전달"만
   * 해도(내용이 실제로 비어 있어도) 채워진 것으로 간주해 폴백을 무력화한다.
   * prop 기본값은 순수 JS 로직이라 그 문제가 없다.
   */
  rightRail?: { title: string; hubs: RailHub[] };
  /**
   * 이 페이지에 애드센스 광고를 실을지 여부. 기본값 true — 우측 레일 광고를
   * 사이트 전반에 노출하는 것이 의도다. 광고가 없어야 하는 페이지(404 등)는
   * 명시적으로 false를 넘긴다. 로더 스크립트와 push 트리거도 이 값을 따라
   * 광고 없는 페이지에는 애드센스 스크립트 자체를 로드하지 않는다.
   */
  hasAds?: boolean;
}
// /search/는 Task 15(Pagefind 검색) 소유 파일이라 이 작업 범위에서
// src/pages/search.astro를 직접 건드릴 수 없다. hasAds prop을 넘기지
// 않은 채로 병합될 가능성에 대비해 경로로도 한 번 더 막는다 — 광고
// 없는 페이지에 애드센스 스크립트를 싣지 않는다는 정책 요구가 우선한다.
const isAdFreeRoute = Astro.url.pathname === "/search/";
const { rightRail, hasAds: hasAdsProp = true } = Astro.props;
const hasAds = hasAdsProp && !isAdFreeRoute;

// Nav/Footer/우측 레일 기본값이 각자 getNavTree()·getSectionCounts()를 따로
// 호출하던 것을 여기서 한 번만 계산해 내려보낸다.
const tree = await getNavTree();
const sectionCounts = await getSectionCounts();
const resolvedRightRail = rightRail ?? {
  title: "인기 주제",
  hubs: topHubsFromTree(tree, 5).map((h) => ({
    href: `/${h.sectionId}/${h.id}/`,
    label: h.label,
    count: h.count,
  })),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...Astro.props} />
    {/* 인라인 스크립트 3개는 2KB 예산 안에 들어가야 해서 압축된 형태로 쓴다
       (변수명 축약·개행 제거). 기능은 각각: 테마 FOUC 방지 초기화 /
       코드블록 복사(성공 시 aria-live로 스크린리더에도 알림) /
       댓글 위젯 클릭 시 지연 로드. */}
    <script is:inline>try{var t=localStorage.getItem("theme");if(t=="light"||t=="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <script is:inline>document.addEventListener("click",function(e){var b=e.target.closest&&e.target.closest("[data-copy]");if(!b)return;var c=b.closest(".codeblock"),p=c.querySelector("pre"),s=c.querySelector("[data-copy-status]");if(!p||!navigator.clipboard)return;navigator.clipboard.writeText(p.innerText).then(function(){b.setAttribute("data-copied","");b.textContent="복사됨";if(s)s.textContent="복사됨";setTimeout(function(){b.removeAttribute("data-copied");b.textContent="복사";if(s)s.textContent=""},1500)})});</script>
    <script is:inline>document.addEventListener("click",function(e){var b=e.target.closest&&e.target.closest("[data-load-comments]");if(!b)return;var w=b.closest(".comments__widget");if(!w)return;var s=document.createElement("script");s.src="https://utteranc.es/client.js";s.setAttribute("repo","umanking/umanking.github.io");s.setAttribute("issue-term","pathname");s.setAttribute("theme","preferred-color-scheme");s.setAttribute("crossorigin","anonymous");s.async=true;w.innerHTML="";w.appendChild(s)});</script>
    {/*
      preload 대상은 146편 본문의 문자 빈도를 실측해서 고른 것이다.
      subset.90(48.3%) + 91(20.5%) + 89(14.8%) = 본문 한글의 약 84%.
      Pretendard의 dynamic subset은 코드포인트 내림차순이라 흔히 쓰는 음절이
      뒤쪽 번호에 몰려 있다. subset.0은 CJK 호환 한자로 사용률이 0%였다.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.90.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.91.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.89.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    {/* 애드센스 로더는 광고가 실제로 표시되는 페이지에만 싣는다.
       async라 렌더 블로킹은 없지만, /search/·404처럼 광고 없는 페이지까지
       실어 보내는 건 불필요한 외부 요청이다. */}
    {hasAds && (
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2431823363518805" crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <TopBar />
    <div class="shell">
      <Nav tree={tree} sectionCounts={sectionCounts} />
      <main id="main" class="shell__main">
        <slot />
      </main>
      <aside class="shell__right" aria-label="관련 정보">
        <RightRail title={resolvedRightRail.title} hubs={resolvedRightRail.hubs} hasAds={hasAds} />
      </aside>
    </div>
    <Footer tree={tree} sectionCounts={sectionCounts} />
    {/* 슬롯마다 push({}) 스크립트를 반복하면 인라인 JS 예산을 금방 넘긴다.
       페이지에 광고가 몇 개든 이 스크립트 하나로 전부 처리한다. */}
    {hasAds && (
      <script is:inline>document.querySelectorAll("ins.adsbygoogle").forEach(function(){(adsbygoogle=window.adsbygoogle||[]).push({})})</script>
    )}
  </body>
</html>
