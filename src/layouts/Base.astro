---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import RightRail, { type RailHub } from "../components/RightRail.astro";
import { getNavTree, getSectionCounts, getHubCounts } from "../lib/taxonomy";
import { CHANNELS, SECTIONS } from "../data/taxonomy";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  jsonLd?: object[];
  /**
   * 우측 레일 위젯. 페이지가 넘기지 않으면 사이트 전체 인기 주제로 대체한다.
   * 슬롯이 아니라 prop인 이유: Astro named slot은 부모가 슬롯을 "전달"만
   * 해도(내용이 실제로 비어 있어도) 채워진 것으로 간주해 폴백을 무력화한다.
   * prop 기본값은 순수 JS 로직이라 그 문제가 없다.
   */
  rightRail?: { title: string; hubs: RailHub[] };
  /** GA4 계측 삽입 여부. 기본값 true. BaseHead로 그대로 전달된다. */
  analytics?: boolean;
}
const { rightRail } = Astro.props;

// Nav/Footer/우측 레일 기본값이 각자 getNavTree()·getSectionCounts()를 따로
// 호출하던 것을 여기서 한 번만 계산해 내려보낸다.
const tree = await getNavTree();
const sectionCounts = await getSectionCounts();
const hubCounts = await getHubCounts();
const currentSection = SECTIONS.find((item) =>
  Astro.url.pathname.startsWith(`/${item.id}/`) || item.label === Astro.props.section
);
const currentChannel = CHANNELS.find((channel) =>
  Astro.url.pathname === channel.href || (currentSection && channel.sections.includes(currentSection.id))
);
const channelHubs: RailHub[] = currentChannel?.id === "technology"
  ? currentChannel.sections
      .map((id) => {
        const section = SECTIONS.find((item) => item.id === id)!;
        return { href: `/${id}/`, label: section.label, count: sectionCounts.get(id) ?? 0 };
      })
      .filter((item) => item.count > 0)
  : (currentChannel?.sections ?? []).flatMap((id) => {
      const section = SECTIONS.find((item) => item.id === id);
      return (section?.hubs ?? [])
        .map((hub) => ({ href: `/${id}/${hub.id}/`, label: hub.label, count: hubCounts.get(`${id}/${hub.id}`) ?? 0 }))
        .filter((item) => item.count > 0);
    });
const resolvedRightRail = currentChannel
  ? { title: `${currentChannel.label} 세부 주제`, hubs: channelHubs }
  : (rightRail ?? { title: "", hubs: [] });
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...Astro.props} />
    {/* 인라인 스크립트 3개는 2KB 예산 안에 들어가야 해서 압축된 형태로 쓴다
       (변수명 축약·개행 제거). 기능은 각각: 테마 FOUC 방지 초기화 /
       코드블록 복사(성공 시 aria-live로 스크린리더에도 알림) /
       댓글 위젯 클릭 시 지연 로드. */}
    <script is:inline>try{var t=localStorage.getItem("theme");if(t=="light"||t=="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <script is:inline>document.addEventListener("click",e=>{var b=e.target.closest?.("[data-copy]");if(!b)return;var c=b.closest(".codeblock"),p=c.querySelector("pre"),s=c.querySelector("[data-copy-status]");if(!p||!navigator.clipboard)return;navigator.clipboard.writeText(p.innerText).then(()=>{b.setAttribute("data-copied","");b.textContent="복사됨";if(s)s.textContent="복사됨";setTimeout(()=>{b.removeAttribute("data-copied");b.textContent="복사";if(s)s.textContent=""},1500)})});</script>
    <script is:inline>document.addEventListener("click",e=>{var b=e.target.closest?.("[data-load-comments]");if(!b)return;var w=b.closest(".comments__widget");if(!w)return;var s=document.createElement("script");s.src="https://utteranc.es/client.js";s.setAttribute("repo","umanking/umanking.github.io");s.setAttribute("issue-term","pathname");s.setAttribute("theme","preferred-color-scheme");s.setAttribute("crossorigin","anonymous");s.async=true;w.innerHTML="";w.appendChild(s)});</script>
    {/*
      preload 대상은 146편 본문의 문자 빈도를 실측해서 고른 것이다.
      subset.90(48.3%) + 91(20.5%) + 89(14.8%) = 본문 한글의 약 84%.
      Pretendard의 dynamic subset은 코드포인트 내림차순이라 흔히 쓰는 음절이
      뒤쪽 번호에 몰려 있다. subset.0은 CJK 호환 한자로 사용률이 0%였다.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.90.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.91.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pretendard/PretendardVariable.subset.89.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <TopBar sectionCounts={sectionCounts} />
    <div class="shell">
      <main id="main" class="shell__main">
        <slot />
      </main>
      <aside class="shell__right" aria-label="관련 정보">
        <RightRail title={resolvedRightRail.title} hubs={resolvedRightRail.hubs} />
      </aside>
    </div>
    <Footer tree={tree} sectionCounts={sectionCounts} />
  </body>
</html>
