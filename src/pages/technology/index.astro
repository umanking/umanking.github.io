---
import Hub from "../../layouts/Hub.astro";
import { getListedPosts } from "../../lib/posts";
import { CHANNELS } from "../../data/taxonomy";
import { absolute } from "../../lib/seo";

const channel = CHANNELS.find((item) => item.id === "technology")!;
const posts = (await getListedPosts()).filter((post) => channel.sections.includes(post.data.section as never));
---

<Hub
  title="기술·AI"
  pageTitle="기술·AI | 맥락"
  description={channel.description}
  lead={channel.description}
  canonical={absolute(channel.href)}
  posts={posts}
  rightRailTitle=""
  rightRailHubs={[]}
/>
