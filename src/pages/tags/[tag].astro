---
import Base from "../../layouts/Base.astro";
import CurationItem from "../../components/CurationItem.astro";
import { getListedPosts, getTagCounts, TAG_INDEX_THRESHOLD } from "../../lib/posts";

export async function getStaticPaths() {
  // 목록·카운트용 경로이므로 getListedPosts() 기준으로 생성한다 (noindex 글 제외).
  const posts = await getListedPosts();
  const counts = await getTagCounts();
  return [...counts.entries()].map(([tag, count]) => ({
    params: { tag },
    props: { tag, count, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, count, posts } = Astro.props;
const canonical = new URL(`/tags/${encodeURIComponent(tag)}/`, Astro.site).href;
// 3편 미만 태그는 색인하지 않는다 (스펙 6.10)
const noindex = count < TAG_INDEX_THRESHOLD;
---

<Base
  title={`${tag} 관련 글 ${count}편 | BRIEFLO`}
  description={`${tag} 관련 정보와 비교·분석 글 ${count}편을 최신순으로 모았습니다.`}
  canonical={canonical}
  noindex={noindex}
  wide
>
  <header class="tag-heading"><a href="/tags/">← 전체 태그</a><h1>#{tag}</h1>
  <p>같은 주제를 다른 관점에서 · {count}편</p></header>
  <div class="tag-posts">{posts.map((post, index) => <CurationItem post={post} rank={index + 1} />)}</div>
</Base>
<style>
  .tag-heading { margin: 20px 0 36px; }
  .tag-heading > a { font-size: .85rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin: 20px 0 12px; letter-spacing: -.04em; }
  p { color: var(--fg-muted); }
  .tag-posts { border-bottom: 1px solid var(--border); }
</style>
