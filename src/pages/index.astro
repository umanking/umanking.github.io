---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getListedPosts } from "../lib/posts";

const canonical = new URL("/", Astro.site).href;
const posts = (await getListedPosts()).slice(0, 30);
---

<Base title="CodeNexus" description="CodeNexus 블로그 글 전체 목록" canonical={canonical}>
  <h1 class="feed-title">최신 글</h1>

  <section aria-labelledby="feed-heading">
    <h2 id="feed-heading" class="sr-only">최신 글 목록</h2>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>

<style>
  .feed-title { margin-bottom: var(--space-4); font-size: 1.5rem; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
