---
import Base from "../layouts/Base.astro";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();
const canonical = new URL("/", Astro.site).href;

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<Base title="CodeNexus" description="CodeNexus 블로그 글 전체 목록" canonical={canonical}>
  <h1>CodeNexus</h1>
  <p class="notice">
    이 페이지는 사이트 개편 작업 중 임시로 만든 전체 글 목록입니다. 정식 홈 화면은 추후
    별도로 제작됩니다.
  </p>

  {
    years.map((year) => (
      <section>
        <h2>{year}</h2>
        <ul class="post-list">
          {postsByYear.get(year)!.map((post) => (
            <li>
              <a href={post.data.permalink}>{post.data.title}</a>
              <p class="description">{post.data.description}</p>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("ko-KR")}
              </time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .notice {
    color: var(--fg-muted);
    font-size: 0.9em;
    padding: var(--space-3);
    background: var(--bg-subtle);
    border-radius: 8px;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
  }
  .post-list li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .post-list .description {
    color: var(--fg-muted);
    margin: var(--space-1) 0;
  }
  .post-list time {
    color: var(--fg-muted);
    font-size: 0.9em;
  }
</style>
