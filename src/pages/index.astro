---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();
const canonical = new URL("/", Astro.site).href;

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<Base title="CodeNexus" description="CodeNexus 블로그 글 전체 목록" canonical={canonical}>
  <h1 class="feed-title">최신 글</h1>

  {
    years.map((year) => (
      <section class="feed-year">
        <h2>{year}</h2>
        {postsByYear.get(year)!.map((post) => <PostCard post={post} />)}
      </section>
    ))
  }
</Base>

<style>
  .feed-title { margin-bottom: var(--space-4); font-size: 1.5rem; }
  .feed-year h2 {
    margin: var(--space-5) 0 0;
    font-size: 1rem;
    color: var(--fg-muted);
    font-weight: 600;
  }
  .feed-year:first-of-type h2 { margin-top: 0; }
</style>
