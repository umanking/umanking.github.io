---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts, getListedPosts } from "../lib/posts";
import { SITE, absolute } from "../lib/seo";
import { organizationLd, webSiteLd, itemListLd } from "../lib/jsonld";

const all = await getAllPosts();
const listed = await getListedPosts();
const latest = listed.slice(0, 15);

const jsonLd = [
  organizationLd(),
  webSiteLd(),
  itemListLd({
    name: "최신 글",
    items: latest.map((p) => ({ title: p.data.title, url: p.data.permalink })),
  }),
];
---

<Base
  title="기술 · AI · 금융·투자 · 부동산 인사이트 미디어 | 맥락"
  description={SITE.description}
  canonical={absolute("/")}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="hero__dot"></span>CONTEXT / INSIGHT MEDIA</p>
      <h1>복잡한 변화에서<br />쓸모 있는 맥락을 찾습니다</h1>
      <p>
        기술의 원리부터 AI의 변화, 금융과 투자의 흐름, 부동산 시장까지.
        직접 확인한 근거와 분명한 관점으로 {all.length}편의 지식과 뉴스를 전합니다.
      </p>
    </div>
  </section>

  <section>
    <h2>최신 글</h2>
    {latest.map((post, i) => (
      <>
        <PostCard post={post} featured={i === 0} />
      </>
    ))}
  </section>
</Base>

<style>
  .hero { position: relative; padding: clamp(3rem, 8vw, 6.5rem) 0 var(--space-6); border-bottom: 1px solid var(--border); overflow: hidden; }
  .hero::before { content: ""; position: absolute; width: 460px; height: 460px; top: -190px; right: 40px; border: 1px solid var(--border-muted); border-radius: 50%; box-shadow: 0 0 0 42px var(--bg), 0 0 0 43px var(--border-muted), 0 0 0 86px var(--bg), 0 0 0 87px var(--border-muted); opacity: .8; pointer-events: none; }
  .hero__copy { position: relative; z-index: 1; }
  .hero__eyebrow { display: flex; align-items: center; gap: 8px; margin-bottom: var(--space-3) !important; color: var(--accent) !important; font-size: .72rem; font-weight: 750; letter-spacing: .14em; }
  .hero__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .hero h1 { max-width: 760px; font-size: clamp(2.35rem, 6vw, 4.8rem); line-height: 1.08; letter-spacing: -.055em; margin: 0 0 var(--space-4); }
  .hero__copy > p:last-child { color: var(--fg-muted); max-width: 650px; margin: 0; font-size: 1.05rem; }
  @media (max-width: 760px) { .hero::before { right: -250px; top: -130px; } }
</style>
