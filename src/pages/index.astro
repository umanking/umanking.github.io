---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts, getListedPosts } from "../lib/posts";
import { SITE, absolute } from "../lib/seo";
import { organizationLd, webSiteLd, itemListLd } from "../lib/jsonld";

const all = await getAllPosts();
const listed = await getListedPosts();
const latest = listed.slice(0, 15);

const jsonLd = [
  organizationLd(),
  webSiteLd(),
  itemListLd({
    name: "최신 글",
    items: latest.map((p) => ({ title: p.data.title, url: p.data.permalink })),
  }),
];
---

<Base
  title="기술 · AI · 금융·투자 · 부동산 인사이트 미디어 | Layer"
  description={SITE.description}
  canonical={absolute("/")}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__copy">
      <p class="hero__eyebrow">INDEPENDENT INSIGHT JOURNAL</p>
      <h1>변화의 층을<br /><span>읽습니다.</span></h1>
      <p>
        기술의 원리부터 AI의 변화, 금융과 투자의 흐름, 부동산 시장까지.<br />
        직접 확인한 근거로 {all.length}편의 깊이 있는 이야기를 전합니다.
      </p>
    </div>
  </section>

  <section>
    <h2>최신 글</h2>
    {latest.map((post, i) => (
      <>
        <PostCard post={post} featured={i === 0} />
      </>
    ))}
  </section>
</Base>

<style>
  .hero { min-height: clamp(390px, 56vw, 570px); display: grid; place-items: center; padding: clamp(4.5rem, 10vw, 8rem) var(--space-3); border-bottom: 1px solid var(--border); text-align: center; }
  .hero__copy { max-width: 920px; }
  .hero__eyebrow { margin: 0 0 var(--space-3) !important; color: var(--accent) !important; font-size: .72rem; font-weight: 650; letter-spacing: .16em; }
  .hero h1 { margin: 0 0 var(--space-4); font-size: clamp(3rem, 8vw, 6.6rem); line-height: .98; font-weight: 700; letter-spacing: -.07em; }
  .hero h1 span { color: var(--fg-muted); }
  .hero__copy > p:last-child { max-width: 700px; margin: 0 auto; color: var(--fg-muted); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
</style>
