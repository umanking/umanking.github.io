{
  "name": "codenexus",
  "version": "1.0.0",
  "description": "Atega is a fast and creative theme for creating a minimal blog for Jekyll. This theme was created for those who want to create a personal blog with simple functions and effects, who appreciate simplicity and functionality. You can start sharing your stories today.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "classify": "node --experimental-strip-types scripts/classify-posts.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umanking/umanking.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/umanking/umanking.github.io/issues"
  },
  "homepage": "https://github.com/umanking/umanking.github.io#readme",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.3.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "satori": "^0.33.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.6"
  }
}
